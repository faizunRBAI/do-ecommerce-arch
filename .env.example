# Copy to .env and fill in real values (never commit .env)

DEBUG=False
SECRET_KEY=your-50-char-random-secret-key-here
ALLOWED_HOSTS=your-droplet-ip,your-domain.com

# Database (Managed PostgreSQL)
DATABASE_URL=postgresql://ecomm_user:password@db-host:25060/ecommerce?sslmode=require
DB_SSL=True

# Cache (Managed Redis)
REDIS_URL=rediss://:password@redis-host:25061/0

# DO Spaces (media storage)
SPACES_BUCKET=your-project-media-xxxx
SPACES_REGION=nyc3
SPACES_ACCESS_KEY=your-spaces-access-key
SPACES_SECRET_KEY=your-spaces-secret-key

# Django environment
APP_ENV=production
DJANGO_SETTINGS_MODULE=do_ecommerce_arch.settings
